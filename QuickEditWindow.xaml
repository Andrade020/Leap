<Window x:Class="Leap.QuickEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Height="720" Width="1040"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#161B22" Padding="12,6">
            <TextBlock x:Name="StatusBar" Foreground="#8B949E" FontSize="12"/>
        </Border>
        <avalonedit:TextEditor x:Name="Editor"
                               FontFamily="Consolas" FontSize="14"
                               ShowLineNumbers="True"
                               Background="#FDFDFD"
                               Padding="6,4"/>
    </DockPanel>
</Window>
